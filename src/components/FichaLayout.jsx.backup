import { useMcpLayout } from '../hooks/useMcpLayout';

export default function FichaLayout() {
  // Lista as ferramentas disponíveis no servidor MCP
  const { data, loading, error } = useMcpLayout();

  if (loading) return (
    <div style={{padding:'2rem',textAlign:'center'}}>
      <p>Buscando ferramentas disponíveis no MCP Stitch...</p>
    </div>
  );
  
  if (error) return (
    <div style={{padding:'2rem',color:'#ff6b6b'}}>
      <h2>Erro ao conectar com MCP</h2>
      <p>{error}</p>
    </div>
  );
  
  if (!data) return (
    <div style={{padding:'2rem'}}>
      <p>Nenhuma ferramenta encontrada.</p>
    </div>
  );

  // Renderiza as ferramentas disponíveis para GERAR layouts
  return (
    <div style={{padding:'2rem'}}>
      <h1>Ficha de Personagem D&D</h1>
      <h2>Ferramentas disponíveis no MCP Stitch:</h2>
      <p style={{color:'#999',marginBottom:'2rem'}}>
        Estas ferramentas podem ser usadas para GERAR layouts dinamicamente.
      </p>
      
      {data.tools && data.tools.length > 0 ? (
        <div style={{marginTop:'1rem'}}>
          {data.tools.map((tool, idx) => (
            <div key={idx} style={{
              background:'#2a2d35',
              padding:'1rem',
              marginBottom:'1rem',
              borderRadius:'8px',
              border:'1px solid #3a3d45'
            }}>
              <h3 style={{margin:'0 0 0.5rem 0',color:'#4fc3f7'}}>{tool.name}</h3>
              {tool.description && <p style={{margin:'0.5rem 0',color:'#aaa'}}>{tool.description}</p>}
              {tool.inputSchema && (
                <details style={{marginTop:'1rem'}}>
                  <summary style={{cursor:'pointer',color:'#81c784'}}>Ver schema de entrada</summary>
                  <pre style={{background:'#1a1d25',padding:'1rem',borderRadius:'4px',overflow:'auto',marginTop:'0.5rem',fontSize:'0.85em'}}>
                    {JSON.stringify(tool.inputSchema, null, 2)}
                  </pre>
                </details>
              )}
            </div>
          ))}
        </div>
      ) : (
        <pre style={{background:'#222',color:'#fff',padding:'1rem',borderRadius:'8px',overflow:'auto'}}>
          {JSON.stringify(data, null, 2)}
        </pre>
      )}
    </div>
  );
}
